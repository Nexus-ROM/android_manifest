<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="nexus"
           fetch="https://github.com/Nexus-ROM"
           revision="lineage-23.2" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/"
           revision="sixteen-qpr2" />

  <remote  name="nexus-cb"
           fetch="https://codeberg.org/Nexus-ROM"
           revision="sixteen-qpr2" />

  <!-- Nexus additions -->
  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="nexus" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed,sysui-studio" remote="nexus" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <project path="bootable/recovery" name="android_bootable_recovery" groups="pdk" remote="nexus" />
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="nexus" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="nexus" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="nexus" />
  <project path="system/core" name="android_system_core" groups="pdk" remote="nexus" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="nexus" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="nexus" />
  <project path="frameworks/native" name="android_frameworks_native" groups="pdk" remote="nexus" />

  <!-- google/pixel apps -->
  <project path="vendor/pixel/extract-utils" name="PixelOS-AOSP/android_vendor_pixel_extract-utils" remote="gitlab" revision="sixteen" >
    <linkfile src="extract-all.sh" dest="vendor/pixel/extract-all.sh" />
  </project>
  <project path="vendor/gms" name="vendor_gms" remote="nexus-cb" />
  
  <!-- Nexus OTA -->
  <project path="vendor/nexusOTA" name="Nexus-ROM/android_vendor_nexusOTA" remote="github" />

</manifest>
